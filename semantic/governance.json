      "allowed_classes": ["public", "operations"],
      "field_actions": {
        "credential_notes": "deny",
        "provider_name": "allow"
      }
    },
    {
      "rule_id": "provider_detail_clinical_admin",
      "principal_roles": ["clinical_admin"],
      "organization_scope": "same_tenant",
      "allowed_purposes": ["operations_analysis"],
      "allowed_classes": ["public", "operations", "restricted"],
      "field_actions": {
        "credential_notes": "allow",
        "provider_name": "allow"
