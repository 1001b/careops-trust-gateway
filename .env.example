# Copy to .env for local model-backed demos. Never commit real secrets.

# LLM synthesis provider: auto | gemini | openai
# auto prefers GEMINI_API_KEY when set, else OPENAI_API_KEY
CAREOPS_LLM_PROVIDER=auto

# Gemini (recommended inexpensive demo path)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings: auto | openai | local
# Keep "local" for offline/CI fairness tests; use openai only if you want OpenAI vectors
CAREOPS_EMBEDDING_PROVIDER=local

# Cap model output tokens (raise if Gemini answers truncate; newer models may use budget for reasoning)
CAREOPS_MAX_OUTPUT_TOKENS=2048
