# Copy to .env for local model-backed demos. Never commit real secrets.

# Required only for OpenAI embeddings + Responses synthesis
OPENAI_API_KEY=

# Inexpensive default for demos; override as needed
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# auto | openai | local  (local = deterministic hash embedder for offline/CI)
CAREOPS_EMBEDDING_PROVIDER=auto

# Cap model output tokens for cost control
CAREOPS_MAX_OUTPUT_TOKENS=600
